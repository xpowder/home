{
  "pages": {
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/[locale]/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/layout.css",
      "static/chunks/app/[locale]/layout.js"
    ],
    "/[locale]/error": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/error.css",
      "static/chunks/app/[locale]/error.js"
    ],
    "/[locale]/loading": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/loading.css",
      "static/chunks/app/[locale]/loading.js"
    ],
    "/[locale]/not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/not-found.css",
      "static/chunks/app/[locale]/not-found.js"
    ],
    "/[locale]/(main)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/(main)/layout.css",
      "static/chunks/app/[locale]/(main)/layout.js"
    ],
    "/[locale]/(main)/providers-dashboard/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/(main)/providers-dashboard/page.css",
      "static/chunks/app/[locale]/(main)/providers-dashboard/page.js"
    ],
    "/[locale]/(main)/(homepage)/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[locale]/(main)/(homepage)/page.css",
      "static/chunks/app/[locale]/(main)/(homepage)/page.js"
    ]
  }
}